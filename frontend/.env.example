# ---------------------------------------------------------------------------
# Modo A (recomendado): un backend que sirve las tres versiones del modelo.
# El frontend selecciona la version con POST /score?version=25|50|100
# ---------------------------------------------------------------------------
# Local:  http://localhost:8000
# Render: https://<tu-servicio>.onrender.com
VITE_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Modo B (opcional): un despliegue de Render por version, cada uno con su
# propia etiqueta de imagen. Si defines alguna de estas variables, el frontend
# las usa y deja de enviar el parametro ?version=.
# ---------------------------------------------------------------------------
# VITE_API_URL_25=https://heart-model-25.onrender.com
# VITE_API_URL_50=https://heart-model-50.onrender.com
# VITE_API_URL_100=https://heart-model-100.onrender.com

# Nota: VITE_* se incrusta en tiempo de compilacion. Tras cambiarlas hay que
# volver a ejecutar `npm run build`.
