# ---------------------------------------------------------------------------
# URL publica del backend. Un solo servicio sirve las tres versiones del
# modelo; el frontend elige con POST /predict?version=25|50|100
# ---------------------------------------------------------------------------
# Local:  http://localhost:8000
# Render: https://<tu-servicio>.onrender.com
VITE_API_URL=http://localhost:8000

# Nota: VITE_* se incrusta en tiempo de compilacion. Tras cambiarla hay que
# volver a ejecutar `npm run build`.
#
# El token de reentrenamiento NO se configura aqui: se escribe en el panel de
# la interfaz y viaja en la cabecera X-Retrain-Token. Su valor es el de la
# variable RETRAIN_TOKEN del backend. Nunca lo pongas en una variable VITE_*,
# porque esas quedan incrustadas en el JavaScript publico.
