    {
      "name": "10. POST /retrain sin token (401 o 503)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{api_url}}/retrain",
          "host": [
            "{{api_url}}"
          ],
          "path": [
            "retrain"
          ]
        },
        "description": "El reentrenamiento nunca debe quedar abierto a cualquiera.",
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"no esta abierto: 401 (token mal) o 503 (sin configurar)\", () => {",
              "  pm.expect(pm.response.code).to.be.oneOf([401, 503]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "11. POST /retrain (lanza el reentrenamiento)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Retrain-Token",
            "value": "{{retrain_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{api_url}}/retrain",
          "host": [
            "{{api_url}}"
          ],
          "path": [
            "retrain"
          ]
        },
        "description": "Dispara el workflow de GitHub Actions, que entrena las tres versiones y publica una imagen de Docker nueva. Requiere que retrain_token tenga el valor de RETRAIN_TOKEN del backend.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dataseturl_25\": \"{{dataset_url_25}}\",\n  \"dataseturl_50\": \"{{dataset_url_50}}\",\n  \"dataseturl_100\": \"{{dataset_url_100}}\",\n  \"nota\": \"Lanzado desde Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 503) {",
              "  pm.test(\"reentrenamiento no configurado en este backend: se omite\", () => {",
              "    pm.expect(pm.response.json().detail).to.include(\"RETRAIN_TOKEN\");",
              "  });",
              "} else {",
              "  pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "  const b = pm.response.json();",
              "  pm.test(\"quedo lanzado\", () => pm.expect(b.dispatched).to.be.true);",
              "  pm.test(\"trae la etiqueta de la imagen nueva\", () => pm.expect(b.tag).to.be.a(\"string\").and.not.empty);",
              "  pm.collectionVariables.set(\"last_tag\", b.tag);",
              "  console.log(\"Imagen nueva etiquetada:\", b.tag, \"->\", b.actions_url);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "12. GET /retrain/status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Retrain-Token",
            "value": "{{retrain_token}}"
          }
        ],
        "url": {
          "raw": "{{api_url}}/retrain/status",
          "host": [
            "{{api_url}}"
          ],
          "path": [
            "retrain",
            "status"
          ]
        },
        "description": "Ultimas corridas del workflow de reentrenamiento."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 503) {",
              "  pm.test(\"reentrenamiento no configurado en este backend: se omite\", () => {",
              "    pm.expect(pm.response.json().detail).to.include(\"RETRAIN_TOKEN\");",
              "  });",
              "} else {",
              "  pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "  pm.test(\"devuelve la lista de corridas\", () => pm.expect(pm.response.json().runs).to.be.an(\"array\"));",
              "}"
            ]
          }
        }
      ]
    }
  ],
