          ],
          "query": [
            {
              "key": "version",
              "value": "77"
            }
          ]
        },
        "description": "Una version que el despliegue no sirve debe dar 404, no un fallo silencioso.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"anio\": 2025,\n  \"mes\": 6,\n  \"clave_ent\": 9,\n  \"bien_juridico_afectado\": \"El patrimonio\",\n  \"tipo_delito\": \"Robo\",\n  \"subtipo_delito\": \"Robo de vehículo automotor\",\n  \"modalidad\": \"Robo de coche de 4 ruedas Con violencia\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));",
              "pm.test(\"el mensaje nombra la version pedida\", () => pm.expect(pm.response.json().detail).to.include(\"77\"));"
            ]
          }
        }
      ]
    },
