    {
      "name": "6. Las tres versiones son modelos distintos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{api_url}}/health",
          "host": [
            "{{api_url}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "No hace una peticion nueva: compara lo que guardaron las anteriores."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const vals = [\"pred_25\",\"pred_50\",\"pred_100\"].map(k => pm.collectionVariables.get(k));",
              "pm.test(\"se consultaron las tres versiones primero\", () => {",
              "  pm.expect(vals.every(v => v !== undefined && v !== null)).to.be.true;",
              "});",
              "pm.test(\"no todas devuelven lo mismo (artefactos no duplicados)\", () => {",
              "  pm.expect(new Set(vals.map(String)).size).to.be.above(1);",
              "});"
            ]
          }
        }
      ]
    },
    {
