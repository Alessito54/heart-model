            }
          }
        },
        {
          "name": "Comparar las 3 versiones (ejecutar tras las anteriores)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const s = ['25','50','100'].map(v => pm.collectionVariables.get('score_' + v));",
                  "pm.test('Se recogieron los 3 scores', () => pm.expect(s.filter(x => x !== undefined && x !== '')).to.have.lengthOf(3));",
                  "pm.test('Los 3 modelos no son identicos', () => pm.expect(new Set(s.map(String)).size).to.be.above(1));",
                  "console.log('25% =', s[0], '| 50% =', s[1], '| 100% =', s[2]);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
