                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve score y version', () => { pm.expect(body.score).to.be.a('number'); pm.expect(body.version).to.be.a('string'); });",
                  "console.log('version por defecto:', body.version, 'score =', body.score);"
                ]
