              ]
            }
          }
        },
        {
          "name": "Listar ejecuciones del workflow",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const runs = pm.response.json().workflow_runs || [];",
                  "pm.test('Hay al menos una ejecucion', () => pm.expect(runs.length).to.be.above(0));",
                  "if (runs.length) { console.log('ultima:', runs[0].status, runs[0].conclusion, runs[0].html_url); }"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{github_token}}"
              },
              {
                "key": "Accept",
                "value": "application/vnd.github+json"
              }
            ],
            "url": {
              "raw": "https://api.github.com/repos/{{github_user}}/{{github_repo}}/actions/runs?per_page=5",
              "protocol": "https",
              "host": [
                "api",
                "github",
                "com"
              ],
              "path": [
                "repos",
                "{{github_user}}",
                "{{github_repo}}",
                "actions",
                "runs"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "5"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Probar el modelo",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Modelo cargado', () => pm.expect(body.model_loaded).to.eql(true));",
                  "pm.test('13 features', () => pm.expect(body.features).to.have.lengthOf(13));",
                  "pm.test('Reporta las versiones servidas', () => pm.expect(body.model_versions).to.have.members(['25','50','100']));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api_url}}/health",
              "host": [
                "{{api_url}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "GET /models",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve una lista', () => pm.expect(body).to.be.an('array'));",
                  "pm.test('Sirve las versiones 25, 50 y 100', () => pm.expect(body.map(m => m.version)).to.have.members(['25','50','100']));",
                  "pm.test('Una sola version por defecto', () => pm.expect(body.filter(m => m.is_default)).to.have.lengthOf(1));",
                  "pm.test('Cada version usa un artefacto distinto', () => pm.expect(new Set(body.map(m => m.path)).size).to.eql(body.length));",
                  "body.forEach(m => console.log(m.version + '% ->', m.path, 'accuracy', m.accuracy));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{api_url}}/models",
              "host": [
                "{{api_url}}"
              ],
              "path": [
                "models"
              ]
            }
          }
        },
        {
          "name": "POST /score?version=25",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve score numerico', () => pm.expect(body.score).to.be.a('number'));",
                  "pm.test('score en [0,1]', () => { pm.expect(body.score).to.be.at.least(0); pm.expect(body.score).to.be.at.most(1); });",
                  "pm.test('Responde la version 25', () => pm.expect(body.version).to.eql('25'));",
                  "pm.collectionVariables.set('score_25', body.score);",
                  "console.log('version 25 score =', body.score);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{payload}}"
            },
            "url": {
              "raw": "{{api_url}}/score?version=25",
              "host": [
                "{{api_url}}"
              ],
              "path": [
                "score"
              ],
              "query": [
                {
                  "key": "version",
                  "value": "25"
                }
              ]
            }
          }
        },
