{
  "openapi": "3.0.2",
  "info": {
    "title": "Heart Disease Prediction",
    "description": "API de inferencia del modelo de prediccion de enfermedad cardiaca. Sirve las versiones entrenadas con el 25 %, 50 % y 100 % del dataset.",
    "version": "2.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/models": {
      "get": {
        "summary": "Models",
        "description": "Versiones del modelo disponibles en este despliegue, con sus metricas.",
        "operationId": "models_models_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Models Models Get",
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ModelInfo"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/score": {
      "post": {
        "summary": "Score",
        "operationId": "score_score_post",
        "parameters": [
          {
            "description": "Version del modelo a usar (25, 50 o 100). Si se omite se usa la version por defecto.",
            "required": false,
            "schema": {
              "title": "Version",
              "type": "string",
              "description": "Version del modelo a usar (25, 50 o 100). Si se omite se usa la version por defecto."
            },
            "name": "version",
            "in": "query"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InputData"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OutputData"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "title": "HTTPValidationError",
        "type": "object",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            }
          }
        }
      },
      "InputData": {
        "title": "InputData",
        "type": "object",
        "properties": {
          "age": {
            "title": "Age",
            "maximum": 120.0,
            "minimum": 1.0,
            "type": "integer",
            "description": "Edad en anios",
            "default": 64
          },
          "sex": {
            "title": "Sex",
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "integer",
            "description": "0 = mujer, 1 = hombre",
            "default": 1
          },
          "cp": {
            "title": "Cp",
            "maximum": 3.0,
            "minimum": 0.0,
            "type": "integer",
            "description": "Tipo de dolor toracico (0-3)",
            "default": 3
          },
          "trestbps": {
            "title": "Trestbps",
            "maximum": 250.0,
            "minimum": 50.0,
            "type": "integer",
            "description": "Presion arterial en reposo (mm Hg)",
            "default": 120
          },
          "chol": {
            "title": "Chol",
            "maximum": 700.0,
            "minimum": 100.0,
            "type": "integer",
            "description": "Colesterol serico (mg/dl)",
            "default": 267
          },
          "fbs": {
            "title": "Fbs",
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "integer",
            "description": "Glucosa en ayunas > 120 mg/dl (0/1)",
            "default": 0
          },
          "restecg": {
            "title": "Restecg",
            "maximum": 2.0,
            "minimum": 0.0,
            "type": "integer",
            "description": "Electrocardiograma en reposo (0-2)",
            "default": 0
          },
          "thalach": {
            "title": "Thalach",
            "maximum": 250.0,
            "minimum": 50.0,
            "type": "integer",
            "description": "Frecuencia cardiaca maxima alcanzada (lpm)",
            "default": 99
          },
          "exang": {
            "title": "Exang",
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "integer",
            "description": "Angina inducida por ejercicio (0/1)",
            "default": 1
          },
          "oldpeak": {
            "title": "Oldpeak",
            "maximum": 10.0,
            "minimum": 0.0,
            "type": "number",
            "description": "Depresion ST inducida por ejercicio",
            "default": 1.8
          },
          "slope": {
            "title": "Slope",
            "maximum": 2.0,
            "minimum": 0.0,
            "type": "integer",
            "description": "Pendiente del segmento ST (0-2)",
            "default": 1
          },
          "ca": {
            "title": "Ca",
            "maximum": 4.0,
            "minimum": 0.0,
            "type": "integer",
            "description": "Vasos principales coloreados por fluoroscopia (0-4)",
            "default": 2
          },
          "thal": {
            "title": "Thal",
            "maximum": 3.0,
            "minimum": 0.0,
            "type": "integer",
            "description": "Talasemia (0-3)",
            "default": 2
          }
        }
      },
      "ModelInfo": {
        "title": "ModelInfo",
        "required": [
          "version",
          "path",
          "is_default"
        ],
        "type": "object",
        "properties": {
          "version": {
            "title": "Version",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "is_default": {
            "title": "Is Default",
            "type": "boolean"
          },
          "n_rows": {
            "title": "N Rows",
            "type": "integer"
          },
          "accuracy": {
            "title": "Accuracy",
            "type": "number"
          },
          "roc_auc": {
            "title": "Roc Auc",
            "type": "number"
          },
          "dataset": {
            "title": "Dataset",
            "type": "string"
          }
        }
      },
      "OutputData": {
        "title": "OutputData",
        "type": "object",
        "properties": {
          "score": {
            "title": "Score",
            "type": "number",
            "default": 0.80318881046519
          },
          "version": {
            "title": "Version",
            "type": "string",
            "default": "100"
          }
        }
      },
      "ValidationError": {
        "title": "ValidationError",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "type": "object",
        "properties": {
          "loc": {
            "title": "Location",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        }
      }
    }
  }
}